# Nusxa oling: .env  (git'ga qo'shilmaydi)
# Faqat frontendga ochiq bo'lishi mumkin bo'lgan qiymatlar VITE_ bilan boshlanadi.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Bot username (@ belgisisiz) — Mini App havolalari uchun
VITE_TELEGRAM_BOT_USERNAME=

# Build versiyasi (xatolik xabarlarida ko'rinadi). CI'da avtomatik: git commit SHA.
# Lokal ishlashda bo'sh qoldiring — '1' ishlatiladi.
VITE_APP_VERSION=

# DIQQAT: service_role kaliti va TELEGRAM_BOT_TOKEN bu yerga YOZILMAYDI.
# Ular faqat Supabase secrets'da saqlanadi:
#   supabase secrets set TELEGRAM_BOT_TOKEN=...
